# Environment, Credentials & Secrets Protection
.env
.env.*
!.env.example
*.env
*client_secrets.json
!*client_secrets.example.json
*token.json
credentials*.json
*.pem
*.key
*.pfx
*.p12

# Local Runtime & Processing Directories
inbox/*
processing/*
uploaded/*
failed/*
archive/*
data/*.db
data/*.db-*
data/*.sqlite*
logs/*.log
logs/reports/*
metadata/*.json

# Binaries & Media Assets
scripts/*.exe
scripts/yt-dlp.exe
scripts/yt-dlp
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.m4v
*.jpg
*.jpeg
*.png
*.wav
*.mp3
*.aac

# Operating System & IDE Artifacts
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# Keep Directory Structures Intact
!.gitkeep
!config/settings.example.json
!config/client_secrets.example.json
!config/settings.json

# Python Virtual Environments & Bytecode
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
