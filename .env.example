# =====================================================================
# UNSTOCKS YT-MANAGER ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and insert your personal API keys/secrets.
# IMPORTANT: Never commit your actual .env file to GitHub!
# =====================================================================

# Google Gemini API Key (For Multimodal Vision, Frame Understanding & SEO Generation)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# YouTube Channel ID & Privacy Setting
YT_CHANNEL_ID=UCT0tm0KSB2BlIjdY6uUZCeA
YT_PRIVACY_STATUS=private

# Custom Inbox Directory (Optional - defaults to C:/Users/<username>/OneDrive/YT-Inbox)
# YT_INBOX_DIR=C:/Users/sanja/OneDrive/YT-Inbox

# Telegram Mobile Bot Integration (Optional)
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# TELEGRAM_ALLOWED_USER_ID=your_telegram_user_id_here
